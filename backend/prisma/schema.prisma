generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  EDITOR
  VIEWER
}

enum BillingType {
  PERCENTAGE
  FIXED
}

enum AmountType {
  PERCENTAGE
  ABSOLUTE
  MIXED
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role       UserRole @default(VIEWER)
  employeeId Int?
  isActive   Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Branch {
  salesExportPreference SalesExportPreference?
  quoConnection QuoConnection?
  quoCampaigns QuoCampaign[]
  id          Int      @id @default(autoincrement())
  branchName  String
  location    String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  dispatcherPercent Float @default(25)
  accountsPercent   Float @default(10)

  salesJobs   SalesJob[]
  salesLeads  SalesLead[]
  interviews  InterviewAssessment[]
  payStatements PayStatement[]
  partnerAgreements PartnerAgreement[]
  contracts   DispatchContract[]
  employees   Employee[]
  companies   Company[]
  trucks      Truck[]
  drivers     Driver[]
  salarySlips SalarySlip[]
  invoices    Invoice[]
  loads       Load[]
  loadReports LoadReport[]
  loadReportReasons LoadReportReason[]
  partners           BranchPartner[]
  dispatchers        BranchDispatcher[]
  settlements        InvoiceSettlement[]
  loans       PartnerLoan[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BranchPartner {
  id        Int      @id @default(autoincrement())

  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name      String
  percent   Float    @default(0)
  phone     String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BranchDispatcher {
  id        Int      @id @default(autoincrement())

  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceSettlement {
  id                     Int         @id @default(autoincrement())

  branchId               Int
  branch                 Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  invoiceId              Int?
  invoiceNumber          String?
  companyName            String?

  totalAmountPKR         Float       @default(0)
  invoiceAmountUSD       Float       @default(0)    // ADD THIS
  usdRate                Float       @default(0)    // ADD THIS

  amountType             AmountType  @default(PERCENTAGE)

  dispatcherType         AmountType  @default(PERCENTAGE)
  dispatcherValue        Float       @default(25)
  dispatcherAmountPKR    Float       @default(0)
  dispatcherSplits       Json?

  accountsType           AmountType  @default(PERCENTAGE)
  accountsValue          Float       @default(10)
  accountsAmountPKR      Float       @default(0)

  partnerProfitPKR       Float       @default(0)
  partnerSplits          Json

  clearedBy              String?
  clearedAt              DateTime    @default(now())
  settlementDate         DateTime?
  notes                  String?

  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model Employee {
  id          Int      @id @default(autoincrement())
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name        String
  phone       String?
  email       String?
  cnic        String?
  role        String   @default("Staff")
  salaryType  String   @default("FIXED")
  fixedSalary Float    @default(0)
  commission  Float    @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Company {
  id               Int         @id @default(autoincrement())
  branchId         Int
  branch           Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyName      String
  ownerName        String?
  mcNumber         String?
  dotNumber        String?
  address          String?
  contactNumber    String?
  email            String?

  billingType      BillingType @default(PERCENTAGE)
  dispatchPercent  Float       @default(0)
  fixedMonthlyRate Float       @default(0)

  accountNumber    String?
  accountTitle     String?
  notes            String?

  trucks           Truck[]
  drivers          Driver[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Truck {
  id            Int      @id @default(autoincrement())
  branchId      Int
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  truckNumber   String
  trailerNumber String?
  notes         String?

  drivers       Driver[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Driver {
  id        Int      @id @default(autoincrement())
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  truckId   Int?
  truck     Truck?   @relation(fields: [truckId], references: [id])

  name      String
  phone     String?
  email     String?
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalarySlip {
  id                Int      @id @default(autoincrement())
  branchId          Int
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  employeeId        Int
  employeeName      String
  designation       String?
  cnic              String?

  salaryType        String

  periodStart       DateTime
  periodEnd         DateTime

  dispatchCompany   String?
  dispatchAmountUSD Float    @default(0)
  commissionPercent Float    @default(0)
  employeeShareUSD  Float    @default(0)

  usdRate           Float    @default(0)
  fixedSalaryPKR    Float    @default(0)
  grossSalaryPKR    Float    @default(0)

  loanDeduction     Float    @default(0)
  advanceDeduction  Float    @default(0)
  otherDeduction    Float    @default(0)
  bonus             Float    @default(0)

  netSalaryPKR      Float    @default(0)
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Invoice {
  id                          Int         @id @default(autoincrement())
  branchId                    Int
  branch                      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyId                   Int?
  companyName                 String?
  ownerName                   String?
  mcNumber                    String?
  dotNumber                   String?
  address                     String?
  contactNumber               String?
  email                       String?

  billingType                 BillingType @default(PERCENTAGE)
  dispatchPercent             Float       @default(0)
  fixedMonthlyRate            Float       @default(0)

  truckNumbers                String?
  driverNames                 String?

  invoiceNumber               String?
  invoiceStart                DateTime
  invoiceEnd                  DateTime
  dueDate                     DateTime?

  accountNumber               String?
  accountTitle                String?

  accountsFeeWeeks            Float       @default(0)
  accountsFeeRate             Float       @default(0)
  accountsFeeTotal            Float       @default(0)

  totalLoadAmount             Float       @default(0)
  totalDispatchAmount         Float       @default(0)
  fixedBillingAmount          Float       @default(0)
  truckRateBreakdown          Json?
  grossAmount                 Float       @default(0)

  discountAmount              Float       @default(0)
  referralBonus               Float       @default(0)
  fineAmount                  Float       @default(0)
  fineReason                  String?

  previousInvoiceAmount       Float       @default(0)
  includePreviousInvoiceInNet Boolean     @default(false)

  netPayable                  Float       @default(0)
  notes                       String?
  isCleared Boolean @default(false)
  clearedAt DateTime?

  loads                       InvoiceLoad[]

  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
}

model InvoiceLoad {
  driverId Int?
  driverName String?
  truckId Int?
  truckNumber String?
  id              Int      @id @default(autoincrement())

  invoiceId       Int
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  date            DateTime
  pickup          String
  dropoff         String
  loadAmount      Float    @default(0)

  dispatchPercent Float    @default(0)
  dispatchAmount  Float    @default(0)
}

model Load {
  id              Int      @id @default(autoincrement())
  branchId        Int
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyId       Int?
  truckId         Int?
  driverId        Int?

  companyName     String?
  truckNumber     String?
  driverName      String?
  driverType      String?
  bookedByTeam    String?
  brokerNameCompany String?
  deliveryTime      String?
  pickupTime        String?
  loadNumber        String?

  loadDate        DateTime
  pickupDate      DateTime?
  dropoffDate     DateTime?

  pickup          String
  dropoff         String

  miles           Float    @default(0)
  ratePerMile     Float    @default(0)
  grossAmount     Float    @default(0)

  loadAmount      Float    @default(0)
  dispatchPercent Float    @default(0)
  dispatchAmount  Float    @default(0)

  source          String   @default("MANUAL")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LoadReportReason {
  id          Int      @id @default(autoincrement())
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyId   Int?
  truckId     Int?

  companyName String?
  truckNumber String?

  reasonDate  DateTime
  reasonType  String
  reasonNote  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LoadReport {
  id             Int      @id @default(autoincrement())
  branchId       Int
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  companyId      Int?
  truckId        Int?

  companyName    String?
  ownerName      String?
  mcNumber       String?
  dotNumber      String?
  truckNumber    String?
  trailerNumber  String?

  reportTitle    String
  periodStart    DateTime
  periodEnd      DateTime

  totalLoads     Int      @default(0)
  totalMiles     Float    @default(0)
  totalGross     Float    @default(0)
  avgRatePerMile Float    @default(0)
  reasonDays     Int      @default(0)

  reportData     Json

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PartnerLoan {
  id              Int      @id @default(autoincrement())

  branchId        Int
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  lenderPartnerId  Int?
  lenderName       String
  lenderIsAccounts Boolean @default(false)

  borrowerPartnerId  Int?
  borrowerName       String
  borrowerIsAccounts Boolean @default(false)

  amount          Float    @default(0)
  note            String?
  loanDate        DateTime @default(now())

  repayments      PartnerLoanRepayment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PartnerLoanRepayment {
  id        Int         @id @default(autoincrement())

  loanId    Int
  loan      PartnerLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  amount    Float       @default(0)
  note      String?
  paidDate  DateTime    @default(now())

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}
model DispatchContract {
  id              Int      @id @default(autoincrement())
  branchId        Int
  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  companyId       Int?
  companyName     String
  companyMC       String
  ratePercent     Float
  seats           Int
  effectiveDate   String
  token           String   @unique
  status          String   @default("PENDING")
  termsText       String
  documentHash    String
  templateVersion String   @default("ewl-1")
  createdBy       Int
  signerName      String?
  consentText     String?
  signedAt        DateTime?
  respondedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId, createdAt])
}

// Client paperwork only. No relation to salary, invoice settlements or account balances.
model PayStatement {
  id            Int      @id @default(autoincrement())
  branchId      Int
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  companyId     Int?
  driverId      Int?
  truckId       Int?
  companyName   String
  recipientName String
  recipientType String
  periodStart   String
  periodEnd     String
  netCents      Int
  snapshot      Json
  revision      Int      @default(1)
  createdBy     Int
  updatedBy     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([branchId, createdAt])
}


// Scores and written responses persist until staff explicitly delete the assessment.
model InterviewAssessment {
  id          Int      @id @default(autoincrement())
  branchId    Int
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  token       String   @unique
  name        String
  status      String   @default("PENDING")
  questions   Json
  responses   Json?
  result      Json?
  createdBy   Int
  reviewedBy  Int?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  recordings  InterviewRecording[]

  @@index([branchId, createdAt])
}

model InterviewRecording {
  id           Int @id @default(autoincrement())
  assessmentId Int
  assessment   InterviewAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  position     Int
  mimeType     String
  duration     Int
  data         Bytes

  @@unique([assessmentId, position])
}


model SalesWorker {
 id String @id
 owner String?
 heartbeatAt DateTime?
 leaseUntil DateTime?
 nextRequestAt DateTime?
 hosted Boolean @default(false)
 tokenHash String?
 schedulerAt DateTime?
}

model SalesJob {
 id Int @id @default(autoincrement())
 branchId Int
 branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
 startMc Int
 endMc Int
 nextMc Int
 status String @default("QUEUED")
 encryptedKey String?
 processed Int @default(0)
 accepted Int @default(0)
 excluded Int @default(0)
 needsReview Int @default(0)
 missing Int @default(0)
 duplicates Int @default(0)
 requests Int @default(0)
 retryCount Int @default(0)
 availableAt DateTime @default(now())
 lastError String?
 reasons Json @default("{}")
 createdBy Int
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 lists SalesList[]
 reviews SalesReview[]
 @@index([branchId, createdAt])
}

model SalesList {
 contactBatches SalesListContactBatch[]
 quoCampaigns QuoCampaign[]
 id Int @id @default(autoincrement())
 jobId Int
 job SalesJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
 ordinal Int
 count Int @default(0)
 startMc Int
 endMc Int
 leads SalesLead[]
 createdAt DateTime @default(now())
 @@unique([jobId, ordinal])
}

model SalesLead {
 id Int @id @default(autoincrement())
 branchId Int
 branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
 listId Int
 list SalesList @relation(fields: [listId], references: [id], onDelete: Restrict)
 mc Int
 usdot String
 name String
 phone String?
 email String?
 address String?
 details Json
 status String @default("NEW")
 notes String @default("")
 followUpDate String?
 contactCount Int @default(0)
 lastContactAt DateTime?
 revision Int @default(1)
 fetchedAt DateTime @default(now())
 contacts SalesContact[]
 @@unique([branchId, mc])
 @@index([listId, mc])
}

model SalesContact {
 id String @id
 leadId Int
 lead SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
 userId Int
 userName String
 createdAt DateTime @default(now())
 undoneAt DateTime?
 @@index([leadId, createdAt])
}

model SalesReview {
 id Int @id @default(autoincrement())
 jobId Int
 job SalesJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
 mc Int
 reason String
 details Json
 createdAt DateTime @default(now())
 @@unique([jobId, mc])
}

model PartnerAgreement {
 id Int @id @default(autoincrement())
 branchId Int
 branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
 settings Json
 termsText String
 documentHash String
 status String @default("PENDING")
 managerTokenHash String @unique
 silentTokenHash String @unique
 encryptedLinks String
 signatures Json @default("{}")
 privateIdentity Json @default("{}")
 revision Int @default(1)
 createdBy Int
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
 @@index([branchId, createdAt(sort: Desc)], map: "PartnerAgreement_branch_created")
}

model QuoConnection {
 branchId Int @id
 branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
 sender String
 phoneNumberId String
 encryptedKey String
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
}
model QuoCampaign {
 id String @id
 branchId Int
 branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
 listId Int
 list SalesList @relation(fields: [listId], references: [id], onDelete: Restrict)
 name String
 template String
 sender String
 phoneNumberId String
 encryptedKey String
 reviewHash String
 status String @default("DRAFT")
 lastError String?
 createdBy Int
 createdAt DateTime @default(now()) @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
 recipients QuoRecipient[]
 @@index([branchId, createdAt(sort: Desc)], map: "QuoCampaign_branch_created")
}
model QuoRecipient {
 id Int @id @default(autoincrement())
 campaignId String
 campaign QuoCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
 leadId Int
 mc Int
 companyName String
 phone String?
 content String
 status String
 reason String?
 providerId String?
 providerStatus String?
 owner String?
 startedAt DateTime? @db.Timestamptz(6)
 updatedAt DateTime @default(now()) @db.Timestamptz(6)
 @@unique([campaignId, leadId])
 @@index([campaignId, status, id], map: "QuoRecipient_campaign_status")
}
model QuoWorker {
 id String @id
 owner String?
 leaseUntil DateTime? @db.Timestamptz(6)
 nextRequestAt DateTime? @db.Timestamptz(6)
 heartbeatAt DateTime? @db.Timestamptz(6)
 schedulerAt DateTime? @db.Timestamptz(6)
}

model SalesExportPreference {
 branchId Int @id
 branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
 messageTemplate String
 enabled Boolean @default(true)
 updatedAt DateTime @default(now()) @db.Timestamptz
}
model SalesListContactBatch {
 id String @id
 listId Int
 list SalesList @relation(fields: [listId], references: [id], onDelete: Restrict)
 userId Int
 leadCount Int
 createdAt DateTime @default(now()) @db.Timestamptz
 @@index([listId])
}
